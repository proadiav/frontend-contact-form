# Public URLs
N8N_HOST=n8n.oummapro.com
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.oummapro.com/
N8N_EDITOR_BASE_URL=https://n8n.oummapro.com/

# n8n security
N8N_ENCRYPTION_KEY=CHANGE_ME

# Supabase (if used)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME

# Postgres (if used)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME
